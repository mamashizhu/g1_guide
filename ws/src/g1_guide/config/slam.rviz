Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Tree Height: 500
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Reference Frame: map
    - Class: rviz_default_plugins/Map
      Name: SLAM Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.8
    - Class: rviz_default_plugins/LaserScan
      Name: Nav Scan
      Enabled: true
      Topic:
        Value: /nav_scan
        Reliability Policy: Best Effort
      Size (m): 0.06
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Style: Points
      Size (Pixels): 4
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Marker Scale: 0.6
      Frames:
        All Enabled: false
        map:
          Value: true
        odom:
          Value: true
        base_link:
          Value: true
        nav_lidar_link:
          Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
      Keep: 200
      Shape:
        Value: Arrow
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 25
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Width: 1200
  Height: 850
