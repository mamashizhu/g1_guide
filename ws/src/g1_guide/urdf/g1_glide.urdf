    <parent link="base_link" />
    <child link="pelvis" />
  </joint>
  <link name="d435_optical_frame" />
  <joint name="d435_optical_joint" type="fixed">
    <parent link="d435_link" />
    <child link="d435_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
  </joint>
  <gazebo reference="d435_link">
    <sensor name="d435_rgbd" type="rgbd">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <topic>/camera</topic>
      <gz_frame_id>d435_optical_frame</gz_frame_id>
      <frame_id>d435_optical_frame</frame_id>
      <camera>
        <horizontal_fov>1.0471975512</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.10</near>
            <far>10.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>
  <link name="nav_lidar_link" />
  <joint name="nav_lidar_joint" type="fixed">
    <origin xyz="0 0 0.47" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="nav_lidar_link" />
  </joint>
  <gazebo reference="mid360_link">
    <sensor name="g1_2d_lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>mid360_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="nav_lidar_link">
    <sensor name="g1_nav_lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>5</update_rate>
      <topic>/nav_scan</topic>
      <gz_frame_id>nav_lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="imu_in_torso">
    <sensor name="g1_imu" type="imu">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>50</update_rate>
      <topic>/imu</topic>
      <gz_frame_id>imu_in_torso</gz_frame_id>
      <imu />
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <gravity>false</gravity>
  </gazebo>
  <gazebo>
    <plugin name="gz::sim::systems::VelocityControl" filename="gz-sim-velocity-control-system">
      <topic>/cmd_vel</topic>
      <initial_linear_velocity>0 0 0</initial_linear_velocity>
      <initial_angular_velocity>0 0 0</initial_angular_velocity>
    </plugin>
    <plugin name="gz::sim::systems::OdometryPublisher" filename="gz-sim-odometry-publisher-system">
      <odom_topic>/odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <tf_topic>/tf</tf_topic>
      <publish_tf>true</publish_tf>
    </plugin>
  </gazebo>
</robot>